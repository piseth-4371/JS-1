# Copy this file to .env  (PowerShell:  Copy-Item .env.example .env)
# .env is gitignored. Never commit real passwords.

# Database (SQLite file for week 1)
DATABASE_URL=sqlite:///./data/app.db

# Market
MT5_SYMBOL=USTEC
# Time zone of the MT5 server clock (MT5 bar times are NOT UTC).
# MetaQuotes-Demo = Europe/Athens. Verify with scripts\check_mt5.py.
MT5_SERVER_TZ=Europe/Athens

# Virtual paper account (USD). 10 USD = 1000 USC on a cent account.
STARTING_BALANCE=1000

# Optional: path to terminal64.exe if MT5 is not in the default location
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Background engine: reads MT5 demo bars every 20 s and runs the strategy.
# Paper only - it never sends orders to MT5. Off by default.
ENGINE_ENABLED=false
ENGINE_SOURCE=mt5:MetaQuotes-Demo

# Weekend BTC paper book (Binance public data, no account needed)
BTC_WEEKEND_ENABLED=true

# Telegram alerts (optional, one-way: signals and feed warnings to your phone; the bot can never trade).
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token here.
# 2) Press START in your new bot, then run:  .\.venv\Scripts\python scripts\telegram_setup.py chat-id
# 3) Put the id below, then:                 .\.venv\Scripts\python scripts\telegram_setup.py test
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Also send setups from strategies that FAILED their backtest (clearly labelled PRACTICE ONLY):
TELEGRAM_PRACTICE_ALERTS=true
# "London / New York entry window open" messages:
TELEGRAM_SESSION_ALERTS=true
